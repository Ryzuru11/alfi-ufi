# Salin file ini jadi .env lalu isi nilai-nilainya

# Port server (default 3001)
PORT=3001

# Google Drive - dari file JSON service account kamu
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ID folder Google Drive "Foto Nikah Alfi & Ufi"
# Ambil dari URL folder Drive: drive.google.com/drive/folders/INI_ID_NYA
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here

# Password dashboard admin
ADMIN_PASSWORD=alfiufi2025

# Jumlah token per sesi tamu (default 5)
TOKENS_PER_SESSION=5

# Allowed origin frontend (isi URL Vercel setelah deploy)
FRONTEND_URL=http://localhost:3000
